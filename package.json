{
  "name": "@dada78641/screp-ts",
  "description": "TypeScript wrapper library for the icza/screp command line tool",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "readme.md"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch src",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msikma/screp-ts.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@dada78641/eslint-config": "^1.0.1",
    "@stylistic/eslint-plugin": "^2.9.0",
    "@types/command-exists": "^1.2.3",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "jiti": "^2.5.1",
    "tsdown": "^0.21.4",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "command-exists": "^1.2.9",
    "lodash.isplainobject": "^4.0.6"
  }
}
